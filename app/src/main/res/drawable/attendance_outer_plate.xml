<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- base gris muy suave -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#E2E6EA"/>
        </shape>
    </item>

    <!-- “bisel” blanco interno (stroke inside simulado con inset) -->
    <item android:insetLeft="1dp" android:insetTop="1dp"
        android:insetRight="1dp" android:insetBottom="1dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#FFFFFFFF"/>
            <solid android:color="#00FFFFFF"/>
        </shape>
    </item>
</layer-list>

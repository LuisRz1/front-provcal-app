<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.sanitary.PolicyManagementFragment">

    <!-- Header Section -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="@string/policies"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:padding="8dp"
        android:text="@string/cerrar_sesion"
        android:textColor="@color/green_500"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvTitle" />

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp">

            <!-- Policy Type Title -->
            <TextView
                android:id="@+id/tvPolicyType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/green_500"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Control de plagas" />

            <!-- Next Revision Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutNextRevision"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/gray_text"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPolicyType">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/next_revision"
                        android:textColor="@color/gray_text"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvNextRevisionDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="Fecha: 05/01/2025" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRevision"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:paddingHorizontal="20dp"
                            android:text="@string/schedule_revision"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            app:backgroundTint="@color/green_500"
                            app:cornerRadius="20dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- History Label and Filter Chips -->
            <TextView
                android:id="@+id/tvHistorialLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Historial"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutNextRevision" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilters"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:chipSpacing="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHistorialLabel"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:checkable="true"
                    android:checked="true"
                    android:minWidth="100dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/history"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    app:chipBackgroundColor="@color/green_500"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="36dp"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip6Months"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:checkable="true"
                    android:minWidth="100dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/filter_6_months"
                    android:textColor="@color/chip_text_color"
                    android:textSize="13sp"
                    app:chipBackgroundColor="@color/chip_background_color"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="36dp"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip1Year"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:checkable="true"
                    android:minWidth="100dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/filter_1_year"
                    android:textColor="@color/chip_text_color"
                    android:textSize="13sp"
                    app:chipBackgroundColor="@color/chip_background_color"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="36dp"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip2Years"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:checkable="true"
                    android:minWidth="100dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/filter_2_years"
                    android:textColor="@color/chip_text_color"
                    android:textSize="13sp"
                    app:chipBackgroundColor="@color/chip_background_color"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="36dp"
                    app:chipStrokeWidth="0dp" />

            </com.google.android.material.chip.ChipGroup>

            <!-- History Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHistoryContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/gray_text"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chipGroupFilters">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- History List -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_revision_history" />

                    <!-- Empty State -->
                    <TextView
                        android:id="@+id/tvEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="32dp"
                        android:gravity="center"
                        android:text="@string/no_history"
                        android:textColor="@color/gray_text"
                        android:textSize="16sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollSchedule"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="96dp"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ====== Próximo Turno ====== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardUseCompatPadding="true"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvNextShiftTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Próximo Turno"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Pastilla fecha -->
                    <LinearLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_date_pill_orange"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <TextView
                            android:id="@+id/tvPillDayNum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="07"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:textColor="@android:color/white" />

                        <TextView
                            android:id="@+id/tvPillDow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DOM"
                            android:textAllCaps="true"
                            android:textSize="12sp"
                            android:textColor="@android:color/white" />
                    </LinearLayout>

                    <!-- Columnas horas -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="16dp"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNextStart"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="09:08 AM"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="@android:color/black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ingreso"
                                android:textSize="12sp"
                                android:textColor="#7297B3" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNextEnd"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="06:05 PM"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="@android:color/black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Salida"
                                android:textSize="12sp"
                                android:textColor="#7297B3" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNextTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="08:13"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="@android:color/black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Horas Totales"
                                android:textSize="12sp"
                                android:textColor="#7297B3" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ====== Turnos Semanales ====== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardUseCompatPadding="true"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvWeeklyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Turnos Semanales"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="12dp" />

                <include
                    android:id="@+id/itemDay1"
                    layout="@layout/item_shift_small" />
                <include
                    android:id="@+id/itemDay2"
                    layout="@layout/item_shift_small" />
                <include
                    android:id="@+id/itemDay3"
                    layout="@layout/item_shift_small" />
                <include
                    android:id="@+id/itemDay4"
                    layout="@layout/item_shift_small" />
                <include
                    android:id="@+id/itemDay5"
                    layout="@layout/item_shift_small" />
                <include
                    android:id="@+id/itemDay6"
                    layout="@layout/item_shift_small" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:id="@+id/textNotifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This is notifications fragment"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

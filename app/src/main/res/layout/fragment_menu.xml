<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Header -->
    <TextView
        android:id="@+id/tvBreadcrumb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Menú > Menú del Mes"
        android:textColor="#18A558"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Navegación de mes -->
    <LinearLayout
        android:id="@+id/layoutMonthNav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBreadcrumb">

        <ImageButton
            android:id="@+id/btnPrevMonth"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_green_button"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Mes anterior"/>

        <TextView
            android:id="@+id/tvCurrentMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Octubre 2025"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2A3642"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>

        <ImageButton
            android:id="@+id/btnNextMonth"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_green_button"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="Mes siguiente"/>
    </LinearLayout>

    <!-- Botón seleccionar archivo -->
    <LinearLayout
        android:id="@+id/layoutFileSelector"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_file_selector"
        android:clipChildren="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutMonthNav">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectFile"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="Seleccionar archivo"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            app:backgroundTint="#18A558"
            app:cornerRadius="0dp"
            app:rippleColor="#0D8A44"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:text="MenuDelMes_Octubre.xlsx"
            android:textColor="#999999"
            android:textSize="14sp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#F5F5F5"/>
    </LinearLayout>

    <!-- Card del calendario -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCalendar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutFileSelector">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Encabezados de días -->
            <LinearLayout
                android:id="@+id/layoutDayHeaders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="7"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DOM"
                    android:textStyle="bold"
                    android:textColor="#2A3642"
                    android:textSize="12sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LUN"
                    android:textStyle="bold"
                    android:textColor="#2A3642"
                    android:textSize="12sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MAR"
                    android:textStyle="bold"
                    android:textColor="#2A3642"
                    android:textSize="12sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MIE"
                    android:textStyle="bold"
                    android:textColor="#2A3642"
                    android:textSize="12sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="JUE"
                    android:textStyle="bold"
                    android:textColor="#2A3642"
                    android:textSize="12sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="VIE"
                    android:textStyle="bold"
                    android:textColor="#2A3642"
                    android:textSize="12sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SAB"
                    android:textStyle="bold"
                    android:textColor="#2A3642"
                    android:textSize="12sp"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- ScrollView para el calendario con altura limitada -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="260dp">

                <GridLayout
                    android:id="@+id/gridCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7"
                    android:rowCount="6"
                    android:alignmentMode="alignBounds"
                    android:useDefaultMargins="false"
                    android:padding="4dp"/>
            </ScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>

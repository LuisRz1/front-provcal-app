<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center">

        <!-- Bloque 1: Ingreso -->
        <LinearLayout
            android:id="@+id/blockIngreso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icIngreso"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_baseline_access_time_24"
                android:contentDescription="@string/ingreso"
                app:tint="#18A558" />

            <TextView
                android:id="@+id/txtHoraIngreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:08 AM"
                android:textStyle="bold"
                android:textColor="#2A3642"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/lblIngreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ingreso"
                android:textColor="#7A8A99"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Separador fino -->
        <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="8dp"
            android:background="#E6EDF2"/>

        <!-- Bloque 2: Salida -->
        <LinearLayout
            android:id="@+id/blockSalida"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icSalida"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_baseline_access_time_24"
                android:tint="#F59E0B"
                android:contentDescription="@string/salida" />

            <TextView
                android:id="@+id/txtHoraSalida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="06:05 PM"
                android:textStyle="bold"
                android:textColor="#2A3642"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/lblSalida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/salida"
                android:textColor="#7A8A99"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Separador fino -->
        <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="8dp"
            android:background="#E6EDF2"/>

        <!-- Bloque 3: Horas Totales -->
        <LinearLayout
            android:id="@+id/blockTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icTotal"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_baseline_access_time_24"
                android:contentDescription="@string/horas_totales"
                app:tint="#18A558" />

            <TextView
                android:id="@+id/txtHorasTotales"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:13"
                android:textStyle="bold"
                android:textColor="#2A3642"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/lblTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/horas_totales"
                android:textColor="#7A8A99"
                android:textSize="12sp"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Chips de comida -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDesayuno"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Desayuno"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                app:backgroundTint="#18A558"
                app:cornerRadius="20dp"
                android:layout_marginEnd="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAlmuerzo"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Almuerzo"
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                app:strokeColor="#E0E0E0"
                app:cornerRadius="20dp"
                android:layout_marginEnd="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCena"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Cena"
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                app:strokeColor="#E0E0E0"
                app:cornerRadius="20dp"/>
        </LinearLayout>

        <!-- Bebida Caliente -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/coffe_time"
                app:tint="#000000"
                android:layout_marginEnd="16dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bebida Caliente"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#202124"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvBebida"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avena con Manzana"
                    android:textSize="14sp"
                    android:textColor="#5F6368"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvBebidaCalorias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="256 Kcal"
                    android:textSize="13sp"
                    android:textColor="#5F6368"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Plato Caliente -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/food_bank_24"
                app:tint="#000000"
                android:layout_marginEnd="16dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plato Caliente"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#202124"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvPlato"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aguadito de pollo con Arroz"
                    android:textSize="14sp"
                    android:textColor="#5F6368"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvPlatoCalorias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="191 Kcal"
                    android:textSize="13sp"
                    android:textColor="#5F6368"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Sandwich -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/food_bank_24"
                app:tint="#000000"
                android:layout_marginEnd="16dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sandwich"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#202124"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvSandwich"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 panes con jamonada"
                    android:textSize="14sp"
                    android:textColor="#5F6368"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvSandwichCalorias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="256 Kcal"
                    android:textSize="13sp"
                    android:textColor="#5F6368"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Total con botón editar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total: 703 Kcal"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#18A558"/>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_edit_24"
                app:tint="#FFFFFF"
                app:backgroundTint="#18A558"
                app:fabSize="normal"
                app:elevation="4dp"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
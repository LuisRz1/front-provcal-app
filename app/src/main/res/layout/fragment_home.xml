<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.sanna.provcalapp.ui.home.HomeViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        tools:context=".ui.home.HomeFragment"
        android:layout_marginTop="40dp">

        <!-- 1) HEADER (usuario) -->
        <include
            android:id="@+id/homeHeader"
            layout="@layout/view_home_header"
            app:viewModel="@{viewModel}"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- 2) HORA + FECHA (centrado bajo el header, sin márgenes fijos) -->
        <LinearLayout
            android:id="@+id/timeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toBottomOf="@id/homeHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/txtTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:15 AM"
                android:textColor="#33424F"
                android:textSize="40sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01 Set, 2025 - Miércoles"
                android:textColor="#7297B3"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- 3) BOTÓN DE ASISTENCIA (layout separado, centrado bajo la fecha) -->
        <include
            android:id="@+id/includeAsistenciaButton"
            layout="@layout/view_asistencia_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/timeContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- 3.5) BOTÓN DE DESCANSO (rectangular, centrado bajo botón de asistencia) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBreak"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="@string/toma_un_break"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:backgroundTint="#3B82F6"
            app:cornerRadius="16dp"
            app:icon="@drawable/coffee"
            app:iconTint="@android:color/white"
            app:iconGravity="textStart"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/includeAsistenciaButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="16dp" />

        <!-- 4) MÓDULO DE ESTADÍSTICAS (Ingreso, Salida, Horas Totales) -->
        <include
            android:id="@+id/homeStats"
            layout="@layout/view_home_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/btnBreak"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menús"
            android:textColor="#18A558"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="32dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <LinearLayout
            android:id="@+id/btnCloseSession"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_power_24"
                app:tint="#18A558"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CERRAR SESIÓN"
                android:textColor="#18A558"
                android:textStyle="bold"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- Breadcrumb -->
        <LinearLayout
            android:id="@+id/layoutBreadcrumb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_arrow_back_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:tint="#18A558"
                android:padding="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carga del menú para el mes:"
                android:textColor="#5F6368"
                android:textSize="15sp"
                android:layout_marginStart="12dp"/>
        </LinearLayout>

        <!-- Card principal -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutBreadcrumb">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Selectores de Año y Mes -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Año:"
                        android:textSize="15sp"
                        android:textColor="#202124"
                        android:textStyle="bold"
                        android:layout_marginEnd="12dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilYear"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="#18A558"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/acYear"
                            android:layout_width="100dp"
                            android:layout_height="50dp"
                            android:text="2025"
                            android:textSize="11sp"
                            android:inputType="none"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mes:"
                        android:textSize="15sp"
                        android:textColor="#202124"
                        android:textStyle="bold"
                        android:layout_marginEnd="12dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilMonth"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="#18A558"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/acMonth"
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Diciembre"
                            android:textSize="11sp"
                            android:inputType="none"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Área de selección de archivo -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFileArea"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="#E0E0E0"
                    app:cardBackgroundColor="#FAFAFA"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="0dp">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:src="@drawable/ic_upload_file_24"
                            app:tint="#18A558"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Seleccionar Archivo para subir"
                            android:textSize="16sp"
                            android:textColor="#202124"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Formato aceptado: Excel"
                            android:textSize="13sp"
                            android:textColor="#5F6368"
                            android:gravity="center"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Máximo: 20 mb"
                            android:textSize="13sp"
                            android:textColor="#5F6368"
                            android:gravity="center"
                            android:layout_marginBottom="16dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelectFile"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="Seleccionar archivo"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            app:backgroundTint="#18A558"
                            app:cornerRadius="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Nombre del archivo (oculto inicialmente) -->
                <LinearLayout
                    android:id="@+id/layoutFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_file_name"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_description_24"
                        app:tint="#18A558"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/tvFileName"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="menu_diciembre_2025.xlsx"
                        android:textSize="13sp"
                        android:textColor="#202124"
                        android:maxLines="1"
                        android:ellipsize="middle"/>

                    <ImageView
                        android:id="@+id/btnRemoveFile"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_close_24"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        app:tint="#5F6368"
                        android:padding="4dp"/>
                </LinearLayout>

                <!-- Warning -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="start"
                    android:background="#FFF8E1"
                    android:padding="14dp"
                    android:layout_marginTop="20dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_warning_24"
                        app:tint="#F9A825"
                        android:layout_marginEnd="10dp"
                        android:layout_gravity="center_vertical"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Verifique que el archivo cubra los menús para las 4 semanas del mes escogido."
                        android:textSize="12sp"
                        android:textColor="#202124"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
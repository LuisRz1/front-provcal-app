<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="550dp"
        android:scrollbars="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Header -->
            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:tint="#5F6368"
                android:padding="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EDITAR MENÚ"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#202124"
                android:letterSpacing="0.02"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- Separador -->
            <View
                android:id="@+id/divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"/>

            <!-- Campos de edición -->
            <LinearLayout
                android:id="@+id/layoutFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/divider">

                <!-- Bebida -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilBebida"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="Bebida"
                    app:boxStrokeColor="#18A558"
                    app:hintTextColor="#18A558">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/acBebida"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Avena con manzana"
                        android:textSize="14sp"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Plato -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPlato"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="Plato"
                    app:boxStrokeColor="#18A558"
                    app:hintTextColor="#18A558">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/acPlato"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aguadito de pollo"
                        android:textSize="14sp"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Guarnición 1 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilGuarnicion1"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="Guarnicion 1"
                    app:boxStrokeColor="#18A558"
                    app:hintTextColor="#18A558">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/acGuarnicion1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Guarnición 2 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilGuarnicion2"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="Guarnicion 2"
                    app:boxStrokeColor="#18A558"
                    app:hintTextColor="#18A558">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/acGuarnicion2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Arroz"
                        android:textSize="14sp"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Pan con: (con contador) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pan con:"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#202124"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPanCon"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        app:boxStrokeColor="#18A558"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/acPanCon"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Jamonada"
                            android:textSize="14sp"
                            android:inputType="none"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Contador -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_counter"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <ImageView
                            android:id="@+id/btnDecrease"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_remove_circle_24"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            app:tint="#5F6368"
                            android:padding="6dp"/>

                        <TextView
                            android:id="@+id/tvQuantity"
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:text="2"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#202124"
                            android:gravity="center"/>

                        <ImageView
                            android:id="@+id/btnIncrease"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_add_circle_24"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            app:tint="#18A558"
                            android:padding="6dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Botón confirmar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirm"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:text="Confirmar"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#18A558"
                app:cornerRadius="10dp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutFields"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
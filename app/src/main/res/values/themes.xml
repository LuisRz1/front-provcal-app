<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base de la aplicación -->
    <style name="Theme.ProvcalApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Color de la barra de estado -->
        <!-- Usa un color similar al fondo superior de tu bg_main -->
        <item name="android:statusBarColor">@color/black</item>

        <!-- Color de la barra de navegación (parte inferior del sistema) -->
        <item name="android:navigationBarColor">@color/black</item>

        <!-- Controla si los íconos de la status bar son oscuros o claros -->
        <!-- true = íconos oscuros (para fondo claro); false = íconos claros (para fondo oscuro) -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- Permite al sistema dibujar los fondos de las barras -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Colores de Material Design (pueden quedar como estaban) -->
        <item name="colorPrimary">@android:color/transparent</item>
        <item name="colorPrimaryVariant">@android:color/transparent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
    </style>
</resources>
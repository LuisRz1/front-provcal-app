        // Then
        assertTrue(result is Result.Error)
        assertEquals("Estado desconocido", (result as Result.Error).message)
    }

    @Test
    fun `uploadMonthlyMenu returns Error when GraphQL has errors on initial upload`() = runTest {
        // Given
        val mockResponse = mockk<ApolloResponse<UploadMonthlyMenuMutation.Data>>()

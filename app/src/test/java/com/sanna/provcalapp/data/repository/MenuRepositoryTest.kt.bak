    @Test
    fun `uploadMonthlyMenu returns Error on network exception`() = runTest {
        // Given
        val exception = mockk<ApolloException>()
        every { exception.message } returns "Connection failed"
        coEvery { mockApolloClient.mutation(any<UploadMonthlyMenuMutation>()).execute() } throws exception

        // When
        val result = repository.uploadMonthlyMenu(
            MenuTestData.testYear,
            MenuTestData.testMonth,
            MenuTestData.testFilename,
            MenuTestData.mockFileBase64,
            false
        )

        // Then
        assertTrue(result is Result.Error)
        assertTrue((result as Result.Error).message.startsWith("Error de conexión:"))
        assertTrue(result.message.contains("Connection failed"))
    }

    // ========================================
    // proposeMenuChange() Tests
    // ========================================

    @Test
    fun `proposeMenuChange returns Success with correct count when mutation succeeds`() = runTest {
        // Given
        val mockResponse = mockk<ApolloResponse<ProposeMenuChangeMutation.Data>>()
        val mockData = mockk<ProposeMenuChangeMutation.Data>()
        val items = listOf(MenuTestData.mockMenuChangeItem, MenuTestData.mockMenuChangeItem2)

        coEvery { mockApolloClient.mutation(any<ProposeMenuChangeMutation>()).execute() } returns mockResponse
        every { mockResponse.hasErrors() } returns false
        every { mockResponse.data } returns mockData
        every { mockData.proposeMenuChange } returns listOf(
            MenuTestData.mockProposeChangeResponse,
            MenuTestData.mockProposeChangeResponse2
        )

        // When
        val result = repository.proposeMenuChange(items)

        // Then
        assertTrue(result is Result.Success)
        assertEquals(2, (result as Result.Success).data)
    }

    @Test
    fun `proposeMenuChange returns Success with count 3 for three changes`() = runTest {
        // Given
        val mockResponse = mockk<ApolloResponse<ProposeMenuChangeMutation.Data>>()
        val mockData = mockk<ProposeMenuChangeMutation.Data>()
        val items = listOf(
            MenuTestData.mockMenuChangeItem,
            MenuTestData.mockMenuChangeItem2,
            MenuTestData.mockMenuChangeItemEmergency
        )

        coEvery { mockApolloClient.mutation(any<ProposeMenuChangeMutation>()).execute() } returns mockResponse
        every { mockResponse.hasErrors() } returns false
        every { mockResponse.data } returns mockData
        every { mockData.proposeMenuChange } returns listOf(
            MenuTestData.mockProposeChangeResponse,
            MenuTestData.mockProposeChangeResponse2,
            MenuTestData.mockProposeChangeResponse3
        )

        // When
        val result = repository.proposeMenuChange(items)

        // Then
        assertTrue(result is Result.Success)
        assertEquals(3, (result as Result.Success).data)
    }

    @Test
    fun `proposeMenuChange returns Success with count 0 when no changes are made`() = runTest {
        // Given
        val mockResponse = mockk<ApolloResponse<ProposeMenuChangeMutation.Data>>()
        val mockData = mockk<ProposeMenuChangeMutation.Data>()
        val items = emptyList<MenuChangeItemInput>()

        coEvery { mockApolloClient.mutation(any<ProposeMenuChangeMutation>()).execute() } returns mockResponse
        every { mockResponse.hasErrors() } returns false
        every { mockResponse.data } returns mockData
        every { mockData.proposeMenuChange } returns emptyList()

        // When
        val result = repository.proposeMenuChange(items)

        // Then
        assertTrue(result is Result.Success)
        assertEquals(0, (result as Result.Success).data)
    }

    @Test
    fun `proposeMenuChange returns Success with count 0 when response is empty`() = runTest {
        // Given
        val mockResponse = mockk<ApolloResponse<ProposeMenuChangeMutation.Data>>()
        val mockData = mockk<ProposeMenuChangeMutation.Data>()
        val items = listOf(MenuTestData.mockMenuChangeItem)

        coEvery { mockApolloClient.mutation(any<ProposeMenuChangeMutation>()).execute() } returns mockResponse
        every { mockResponse.hasErrors() } returns false
        every { mockResponse.data } returns mockData
        every { mockData.proposeMenuChange } returns emptyList()

        // When
        val result = repository.proposeMenuChange(items)

        // Then
        assertTrue(result is Result.Success)
        assertEquals(0, (result as Result.Success).data)
    }

    @Test
    fun `proposeMenuChange returns Error when GraphQL has errors`() = runTest {
        // Given
        val mockResponse = mockk<ApolloResponse<ProposeMenuChangeMutation.Data>>()
        val mockError = mockk<Error>()
        val items = listOf(MenuTestData.mockMenuChangeItem)

        coEvery { mockApolloClient.mutation(any<ProposeMenuChangeMutation>()).execute() } returns mockResponse
        every { mockResponse.hasErrors() } returns true
        every { mockResponse.errors } returns listOf(mockError)
        every { mockError.message } returns "Error proponiendo cambios"

        // When
        val result = repository.proposeMenuChange(items)

        // Then
        assertTrue(result is Result.Error)
        assertEquals("Error proponiendo cambios", (result as Result.Error).message)
    }

    @Test
    fun `proposeMenuChange returns Error on network exception`() = runTest {
        // Given
        val exception = mockk<ApolloException>()
        every { exception.message } returns "Network error"
        val items = listOf(MenuTestData.mockMenuChangeItem)
        coEvery { mockApolloClient.mutation(any<ProposeMenuChangeMutation>()).execute() } throws exception

        // When
        val result = repository.proposeMenuChange(items)

        // Then
        assertTrue(result is Result.Error)
        assertTrue((result as Result.Error).message.startsWith("Error de conexión:"))
        assertTrue(result.message.contains("Network error"))
    }
}

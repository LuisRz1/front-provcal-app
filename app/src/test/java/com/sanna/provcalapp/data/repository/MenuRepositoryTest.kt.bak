        every { mockData.uploadMonthlyMenu } returns MenuTestData.mockUploadErrorResponse

        // When
        val result = repository.uploadMonthlyMenu(
            MenuTestData.testYear,
            MenuTestData.testMonth,
            MenuTestData.testFilename,
            MenuTestData.mockFileBase64,
            false
        )

        // Then
        assertTrue(result is Result.Error)
        assertEquals("Error al procesar el archivo", (result as Result.Error).message)
    }

